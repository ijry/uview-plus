<template>
	<view class="content">		
		<view class="main">
			<view class="card" :style="[upThemeCardStyle]">
        <text class="title" :style="{ color: upThemeVar('--up-main-color') }">颜色选择器示例</text>
				
                <up-color-picker
                    v-model="selectedColor"
                    :show="showColorPicker"
                    @confirm="confirmColor"
                    @close="showColorPicker = false"
                >
            <view class="color-preview" :style="{ backgroundColor: upThemeVar('--up-bg-color') }">
                <view class="color-block" :style="{ backgroundColor: selectedColor, borderColor: upThemeVar('--up-border-color') }"></view>
                <text class="color-text" :style="{ color: upThemeVar('--up-content-color') }">{{ selectedColor }}</text>
                    </view>
                </up-color-picker>
				
				
            <text class="desc" :style="{ color: upThemeVar('--up-tips-color') }">点击上方色块选择颜色</text>
			</view>
			
			<view class="card" :style="[upThemeCardStyle]">
        <text class="title" :style="{ color: upThemeVar('--up-main-color') }">带常用颜色的示例</text>
				<up-color-picker
                    v-model="selectedColor2"
                    :show="showColorPickerWithCommon"
                    :commonColors="commonColors"
                    @confirm="confirmColor2"
                    @close="showColorPickerWithCommon = false"
                >
            <view class="color-preview" :style="{ backgroundColor: upThemeVar('--up-bg-color') }">
                <view class="color-block" :style="{ backgroundColor: selectedColor2, borderColor: upThemeVar('--up-border-color') }"></view>
                <text class="color-text" :style="{ color: upThemeVar('--up-content-color') }">{{ selectedColor2 }}</text>
                    </view>
                    </up-color-picker>
            <text class="desc" :style="{ color: upThemeVar('--up-tips-color') }">包含常用颜色选项</text>
			</view>
		</view>
	</view>
</template>

<script setup>
import { ref } from 'vue';

// 定义响应式数据
const selectedColor = ref('#ff0000');
const selectedColor2 = ref('#00ff00');
const showColorPicker = ref(false);
const showColorPickerWithCommon = ref(false);
const commonColors = ref([
	'#ff0000',
	'#00ff00',
	'#0000ff',
	'#ffff00',
	'#00ffff',
	'#ff00ff',
	'#ffffff',
	'#000000'
]);

// 定义方法
const confirmColor = (color) => {
	selectedColor.value = color;
};

const confirmColor2 = (color) => {
	selectedColor2.value = color;
};
</script>

<style>
	.content {
		flex: 1;
	}
	
	.main {
		padding: 20rpx;
	}
	
	.card {
		border-radius: 16rpx;
		padding: 30rpx;
		margin-bottom: 20rpx;
	}
	
	.title {
		font-size: 32rpx;
		font-weight: bold;
		color: var(--up-main-color, #333);
		display: block;
		margin-bottom: 30rpx;
	}
	
	.color-preview {
		display: flex;
		align-items: center;
		padding: 30rpx;
		border-radius: 12rpx;
		cursor: pointer;
	}
	
	.color-block {
		width: 80rpx;
		height: 80rpx;
		border-radius: 12rpx;
		margin-right: 30rpx;
		border: 1px solid var(--up-border-color, #eee);
	}
	
	.color-text {
		font-size: 28rpx;
		color: var(--up-content-color, #666);
		flex: 1;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	
	.desc {
		display: block;
		font-size: 24rpx;
		color: var(--up-tips-color, #999);
		margin-top: 20rpx;
	}
</style>
