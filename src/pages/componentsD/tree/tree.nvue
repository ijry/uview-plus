  padding: 8px 0;
}

.custom-tree-node {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.custom-tree-node__label {
  color: var(--up-main-color, #303133);
  font-size: 28rpx;
}

.custom-tree-node__tag {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 999px;
  color: var(--up-primary, #3c9cff);
  background-color: var(--up-primary-light, #ecf5ff);
  font-size: 22rpx;
}

.custom-tree-node__state {
  margin-left: 12rpx;
  color: var(--up-tips-color, #909193);
  font-size: 22rpx;
}

.tree-actions {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}

.tree-action-button {
  width: 150rpx;
  margin-right: 16rpx;
}

.tree-result {
  display: block;
