<template>
    <view class="u-page">
      <view class="u-page__item">
          <text class="u-page__item__title" style="margin-top: 0;">头像裁剪</text>
          <view class="u-page__item__content">
            <view class="cut-box">
                <up-cropper @confirm="cutImage" ref="avatarRef0" :canChangeSize="false"
                    areaWidth="300rpx" areaHeight="300rpx" exportWidth="260rpx" exportHeight="260rpx">
                    <view class="avatar-wrapper">
                        <up-avatar class="avatar" :src="urls[0]" size="120px"></up-avatar>
                    </view>
                </up-cropper>
            </view>
          </view>
      </view>
      <view class="u-page__item">
          <text class="u-page__item__title" style="margin-top: 0;">可变大小</text>
          <view class="u-page__item__content">
            <view class="cut-box">
                <view class="avatar-wrapper" @click="chooseImage1(1)">
                    <up-image :src="urls[1]" height="160px"></up-image>
                </view>
                <up-cropper @confirm="cutImage" ref="avatarRef1"></up-cropper>
            </view>
          </view>
      </view>
      <view class="u-page__item">
          <text class="u-page__item__title" style="margin-top: 0;">限制在图片内</text>
          <view class="u-page__item__content">
            <view class="cut-box">
                <view class="avatar-wrapper" @click="chooseImageInner(2)">
                    <up-avatar class="avatar" :src="urls[2]" size="120px"></up-avatar>
                </view>
                <up-cropper @confirm="cutImage" ref="avatarRefInner"></up-cropper>
            </view>
          </view>
      </view>
  </view>
</template>

<script setup>
import { ref } from 'vue';

// 定义响应式数据
const urls = ref([]);

// 定义引用
const avatarRef0 = ref(null);
const avatarRef1 = ref(null);
const avatarRefInner = ref(null);

// 定义方法
const chooseImage1 = (index) => {
    avatarRef1.value.chooseImage(index, {
        canChangeSize: true,
        areaWidth: "300rpx", areaHeight: "180rpx",
        exportWidth: '260rpx', exportHeight: '160rpx'
    });
};

const chooseImageInner = (index) => {
    avatarRefInner.value.chooseImage(index, {
        inner: true,
        canChangeSize: false,
        areaWidth: "300rpx",
        areaHeight: "300rpx",
        exportWidth: '260rpx',
        exportHeight: '260rpx'
    });
};

const cutImage = (rsp) => {
    console.log(rsp);
    urls.value[rsp.index] = rsp.path;
};
</script>

<style lang="scss" scoped>
  .u-page__item {
      margin-bottom: 15px;
  }
  .u-page__item__title {
      margin-bottom: 10px;
  }
</style>
